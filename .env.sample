# 環境変数のテンプレート
# このファイルをコピーして .env を作成してください

# API関連
NEXT_PUBLIC_API_URL=

# デモモード設定（true または false）
NEXT_PUBLIC_DEMO_MODE=false

# Database (MySQL)
# docker compose のデフォルト設定に合わせています
DATABASE_URL=mysql://root:root_password@localhost:3307/app_db
# root アカウントを使うため Prisma が自動で shadow DB を作成します。
# カスタム shadow DB が必要な場合だけ SHADOW_DATABASE_URL を設定してください。
# SHADOW_DATABASE_URL=mysql://root:root_password@localhost:3307/prisma_shadow
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=app_db
MYSQL_ROOT_PASSWORD=root_password

# 外部サービス（必要に応じて追加）
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
