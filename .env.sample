# 環境変数のテンプレート
# このファイルをコピーして .env を作成してください

# API関連
NEXT_PUBLIC_API_URL=

# Database (MySQL)
# docker compose のデフォルト設定に合わせています
DATABASE_URL="mysql://app_user:app_password@localhost:3307/app_db"
SHADOW_DATABASE_URL="mysql://root:root_password@localhost:3307/app_db_shadow"
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

# 外部サービス（必要に応じて追加）
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
