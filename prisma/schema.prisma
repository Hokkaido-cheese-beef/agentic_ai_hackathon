generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TripGroupStatus {
  draft
  active
  completed
}

model TripGroup {
  trip_group_id String          @id @default(uuid()) @db.Char(36)
  name          String
  departure     String?
  status        TripGroupStatus @default(draft)
  created_at    DateTime        @default(now())

  candidates TripCandidate[]
  questions  Question[]

  @@map("trip_groups")
}

model TripCandidate {
  id            String   @id @default(uuid()) @db.Char(36)
  trip_group_id String   @db.Char(36)
  name          String
  description   String?  @db.Text
  image_url     String?
  rating        Float?
  review_count  Int?
  tags          String?  @db.Text
  info          String?  @db.Text
  ai_summary    String?  @db.Text
  source_url    String?
  created_at    DateTime @default(now())

  tripGroup TripGroup  @relation(fields: [trip_group_id], references: [trip_group_id], onDelete: Cascade)
  questions Question[]

  @@index([trip_group_id])
  @@map("trip_candidates")
}

model Question {
  id            String   @id @default(uuid()) @db.Char(36)
  candidate_id  String?  @db.Char(36)
  trip_group_id String   @db.Char(36)
  content       String   @db.Text
  ai_answer     String?  @db.Text
  created_at    DateTime @default(now())

  tripGroup TripGroup      @relation(fields: [trip_group_id], references: [trip_group_id], onDelete: Cascade)
  candidate TripCandidate? @relation(fields: [candidate_id], references: [id], onDelete: SetNull)

  @@index([trip_group_id])
  @@index([candidate_id])
  @@map("questions")
}
