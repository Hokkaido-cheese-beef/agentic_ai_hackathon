# 環境変数のテンプレート
# このファイルをコピーして .env を作成してください

# API関連
NEXT_PUBLIC_API_URL=

# デモモード設定（true または false）
NEXT_PUBLIC_DEMO_MODE=false

# 外部サービス（必要に応じて追加）
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Firebase (NEXT_PUBLIC_DEMO_MODE = false の場合に必要)
GOOGLE_CLOUD_PROJECT=your_project_id
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_LOCATION=global

# AI サーバー（通常は Cloud Run の環境変数で自動注入）
# GO_AI_SERVER_URL=https://your-ai-service-xxxx.a.run.app
# ローカルから private AI Cloud Run を呼ぶ場合のみ設定
# GO_AI_ID_TOKEN=your_identity_token
